{
  "manifest_version": 3,
  "name": "NoteCraft Spike",
  "version": "0.0.7",
  "minimum_chrome_version": "120",
  "description": "note執筆中の原稿を拡張機能自身のローカル領域へ保存する技術検証版。外部送信なし・本文書き換えなし。",
  "permissions": [
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://note.com/notes/*",
        "https://note.com/new",
        "https://editor.note.com/notes/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false,
      "world": "ISOLATED"
    }
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'none'; img-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none';"
  }
}
